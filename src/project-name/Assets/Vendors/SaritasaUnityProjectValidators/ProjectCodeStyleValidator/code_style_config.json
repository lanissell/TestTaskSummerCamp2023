{
  "rules": {
    ".cs": {
      "patterns": [
        {
          "pattern": "^\\s*class\\s+[a-z]",
          "comment": "Class names should start with uppercase letter (PascalCase)"
        },
        {
          "pattern": "^\\s*public\\s+(?!class|interface|struct|enum|static\\s+(class|interface|struct|enum))\\w+\\s+[a-z]",
          "comment": "Public fields should use PascalCase naming"
        },
        {
          "pattern": "^\\s*private\\s+(?!class|interface|struct|enum)\\w+\\s+[A-Z]\\w*(?!\\s*\\()(?:\\s*[={;]|\\s*$)",
          "comment": "Private fields should start with lowercase or underscore (camelCase or _camelCase)"
        },
        {
          "pattern": "^\\s*public\\s+(static\\s+)?(?!class|interface|struct|enum)\\w+\\s+[a-z]\\w*\\s*\\(",
          "comment": "Method names should use PascalCase"
        },
        {
          "pattern": "\\s+$",
          "comment": "No trailing whitespace allowed"
        },
        {
          "pattern": "^\\s*interface\\s+[^I][A-Z]",
          "comment": "Interface names should start with 'I' prefix"
        },
        {
          "pattern": "\\t",
          "comment": "Use spaces instead of tabs for indentation"
        },
        {
          "pattern": "^\\s*namespace\\s+[a-z]",
          "comment": "Namespace names should use PascalCase"
        }
      ]
    }
  },
  "ignore_dirs": [
    "Vendors",
    "UserWorkspace",
    "Plugins",
    "TextMesh Pro",
    "Packages",
    "Npm"
  ]
}
